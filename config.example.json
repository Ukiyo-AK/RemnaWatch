{
  "host": "127.0.0.1",
  "port": 8080,
  "auth": {"token": ""},
  "network_origin": "unknown",
  "live_connections": {
    "enabled": false,
    "adapter": "linux_inet_diag",
    "protocols": ["tcp", "udp"],
    "fields": ["local_ip", "local_port", "peer_ip", "peer_port"],
    "poll_seconds": 5,
    "max_connections": 10000,
    "max_changes": 10000,
    "snapshot_ttl_seconds": 30,
    "tombstone_seconds": 60
  },
  "database": "domains.sqlite",
  "strict_user_uuid": true,
  "domains": {"enabled": true, "event_days": 7, "aggregate_days": 30, "purge_on_disable": true},
  "users": [{"node_id": "node-1", "inbound": "vless", "email": "xray-user-email", "user_id": "59cf9ada-b568-4513-8582-923576b05ef3"}],
  "access_logs": [{"node_id": "node-1", "path": "/var/log/xray/access.log", "utc_offset_minutes": 0, "client_request_verified": false, "start_at_end": true, "batch_lines": 1000, "poll_seconds": 1}],
  "network": [],
  "management": {
    "enabled": false,
    "compose_file": "/opt/remnanode/docker-compose.yml",
    "compose_service": "remnanode",
    "interfaces": ["eth0"],
    "memory_services": ["remnawatch.service"],
    "os_kernel_package": "linux-generic"
  },
  "protection": {
    "memory_pause_percent": 92,
    "memory_resume_percent": 85,
    "disk_max_used_percent": 90,
    "disk_min_free_bytes": 268435456,
    "log_directories": ["/var/log/remnanode"],
    "delete_rotated_logs": true,
    "early_history_cleanup": true,
    "min_rotated_age_seconds": 3600,
    "keep_event_seconds": 3600,
    "keep_aggregate_seconds": 86400,
    "max_delete_files": 100
  }
}
